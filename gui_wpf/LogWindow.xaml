<Window x:Class="RenPyPatcherGui.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志" Height="420" Width="680" WindowStartupLocation="CenterOwner"
        Background="#0F172A" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" Height="6" Margin="0,0,0,6">
            <ProgressBar x:Name="pbProgress" Minimum="0" Maximum="100" Value="0"
                         Background="#1E293B" Foreground="#38BDF8"/>
        </Grid>
        <TextBlock x:Name="txtStatus" DockPanel.Dock="Top" Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,6" Text="就绪"/>
        <ListBox x:Name="lstLog" Background="#0F172A" Foreground="#CBD5E1" FontSize="11" BorderThickness="0"/>
    </DockPanel>
</Window>
