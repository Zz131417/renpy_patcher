<Window x:Class="RenPyPatcherGui.ModManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mod 管理" Height="660" Width="820" WindowStartupLocation="CenterOwner"
        Background="#F1F5F9" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock x:Name="txtTitle" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,10"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 注入 Mod 引擎 -->
                <GroupBox Header="注入 Mod 引擎">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#475569" FontSize="11" Margin="0,0,0,6">
                            选择注入方式：Drop-in（游戏启动自动读取 game/mod/ 与 game/dll/，改 mod 无需重打包）或
                            运行时热注入（把 DLL 注入到运行中的游戏进程）。
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="rbDropin" Content="Drop-in（游戏自读 mod/ dll/）" IsChecked="True"
                                         Margin="0,0,16,0" Checked="EngineMode_Changed" Unchecked="EngineMode_Changed"/>
                            <RadioButton x:Name="rbHot" Content="运行时热注入（进程）"
                                         Checked="EngineMode_Changed" Unchecked="EngineMode_Changed"/>
                        </StackPanel>

                        <!-- Drop-in 面板 -->
                        <Grid x:Name="gridDropin">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Label Content="已解包目录"/><TextBox x:Name="txtDiGame" Grid.Column="1" Margin="4"/>
                                    <Button x:Name="btnDiGame" Grid.Column="2" Content="浏览" Width="60" Click="BtnDiGame_Click"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Label Content="Mod目录"/><TextBox x:Name="txtDiMod" Grid.Column="1" Margin="4"/>
                                    <Button x:Name="btnDiMod" Grid.Column="2" Content="浏览" Width="60" Click="BtnDiMod_Click"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Label Content="DLL目录"/><TextBox x:Name="txtDiDll" Grid.Column="1" Margin="4"/>
                                    <Button x:Name="btnDiDll" Grid.Column="2" Content="浏览" Width="60" Click="BtnDiDll_Click"/>
                                </Grid>
                                <Button x:Name="btnDiInstall" Content="安装 Drop-in" Width="110" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="BtnDiInstall_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- 热注入面板 -->
                        <Grid x:Name="gridHot" Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Label Content="目标 PID"/><TextBox x:Name="txtHotPid" Grid.Column="1" Margin="4"/>
                                    <Button x:Name="btnHotDll" Grid.Column="2" Content="浏览DLL" Width="70" Click="BtnHotDll_Click"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Label Content="DLL 文件"/><TextBox x:Name="txtHotDll" Grid.Column="1" Margin="4"/>
                                </Grid>
                                <Button x:Name="btnHotInject" Content="注入到进程(PID)" Width="130" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="BtnHotInject_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="txtEngineStatus" Foreground="#64748B" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- 已安装 Mod -->
                <GroupBox Header="已安装 Mod（game/mod/）">
                    <StackPanel>
                        <TextBlock x:Name="txtModHint" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <ListBox x:Name="lstMods" BorderThickness="0" Background="Transparent" MaxHeight="240">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#0F172A"/>
                                            <CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding Enabled}" Tag="{Binding}"
                                                      Checked="ModEnabled_Changed" Unchecked="ModEnabled_Changed" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="btnRefreshMods" Content="刷新" Width="80" Style="{StaticResource PrimaryButton}" Click="BtnRefreshMods_Click"/>
                            <Button x:Name="btnOpenModDir" Content="打开 Mod 目录" Width="120" Margin="8,0,0,0" Click="BtnOpenModDir_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
