<Window x:Class="RenPyPatcherGui.InjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DLL 注入" Height="400" Width="560" Background="#F1F5F9"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="DLL 文件" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="txtDll" Grid.Column="0" Margin="4" ToolTip="要注入的动态库（建议与目标进程同位数）"/>
                <Button x:Name="btnBrowseDll" Grid.Column="1" Content="浏览" Width="60" Click="BtnBrowseDll_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="注入目标" Grid.Row="1">
            <StackPanel>
                <RadioButton x:Name="rbPid" Content="注入到运行中的进程（指定 PID）" IsChecked="True" Margin="0,4"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Label Content="PID"/>
                    <TextBox x:Name="txtPid" Grid.Column="1" Margin="4" ToolTip="目标进程 ID（任务管理器可查）"/>
                </Grid>
                <RadioButton x:Name="rbLaunch" Content="启动程序并注入" Margin="0,10,0,4"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Label Content="exe"/>
                    <TextBox x:Name="txtExe" Grid.Column="1" Margin="4"/>
                    <Button x:Name="btnBrowseExe" Grid.Column="2" Content="浏览" Width="60" Click="BtnBrowseExe_Click"/>
                    <Label Grid.Column="3" Content="延迟ms" Margin="8,0,0,0"/>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <Label Content="注入延迟"/>
                    <TextBox x:Name="txtDelay" Grid.Column="1" Margin="4" Text="0" ToolTip="0=挂起进程注入后恢复（最稳）；>0=启动后等待该毫秒数再注入"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="txtStatus" Grid.Row="2" Margin="4,10" TextWrapping="Wrap"
                   Foreground="#475569" VerticalAlignment="Top" Text="选择 DLL 与注入目标后点「注入」。仅 Windows 可用。"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnInject" Content="注入" Width="100" Style="{StaticResource PrimaryButton}" Click="BtnInject_Click"/>
            <Button x:Name="btnClose" Content="关闭" Width="80" Margin="8,0,0,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
