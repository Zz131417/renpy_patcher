#ifndef RENPY_PATCHER_VERSION_H
#define RENPY_PATCHER_VERSION_H

/* 本文件由 CMake 根据根目录 VERSION 与 git 提交自动生成，请勿手工编辑。
 * 单一事实来源：VERSION 文件（语义化版本，如 0.1.0）。 */

#define RPATCHER_VERSION_MAJOR  @RPATCHER_VERSION_MAJOR@
#define RPATCHER_VERSION_MINOR  @RPATCHER_VERSION_MINOR@
#define RPATCHER_VERSION_PATCH  @RPATCHER_VERSION_PATCH@
#define RPATCHER_VERSION_STRING "@RPATCHER_VERSION_STRING@"

/* 完整版本（含构建元数据：git commit） */
#define RPATCHER_VERSION_FULL   "@RPATCHER_VERSION_FULL@"

/* 构建来源 git commit（无 git 时为 "unknown"） */
#define RPATCHER_BUILD_COMMIT   "@RPATCHER_BUILD_COMMIT@"

#endif /* RENPY_PATCHER_VERSION_H */
